{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "oci-containers images, pinned as tag@digest",
      "managerFilePatterns": ["/^modules/.+\\.nix$/"],
      "matchStrings": [
        "image = \"(?<depName>[^\"@]+?):(?<currentValue>[^\"@:]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "databases move by digest only; a new major needs a dump and restore",
      "matchPackageNames": [
        "postgres",
        "ghcr.io/immich-app/postgres",
        "docker.io/valkey/valkey"
      ],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": "immich's server and machine learning must run the same release",
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich"
    }
  ]
}
